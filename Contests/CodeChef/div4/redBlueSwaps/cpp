//Recursion

int dfs(int i,int n, vector<int>&bin, vector<int>&nums,vector<vector<int>> &dp){
    if(i>=n) return 1;

    int cnt1 = 1, cnt2 =1 ;
    const int mod = 998244353;

    if(bin[i]==0 && i+1 <n && bin[i+1] && nums[i]>nums[i+1]){

        swap(nums[i],nums[i+1]);
        swap(bin[i],bin[i+1]);
          cnt1 =  (dfs(i+1,n,bin,nums,dp))%mod;
          swap(nums[i], nums[i+1]);
        swap(bin[i], bin[i+1]);
    }
    if(bin[i]==0 && i-1 >=0 && bin[i-1] && nums[i]>nums[i-1]){
       swap(nums[i], nums[i-1]);
        swap(bin[i], bin[i-1]);
        cnt2 = (dfs(i-1,n,bin,nums,dp))%mod;
        swap(nums[i], nums[i-1]);
        swap(bin[i], bin[i-1]);
    }
    if (cnt1 == 1 && cnt2 == 1) {
        return dfs(i+1, n, bin, nums, dp);
    }

    long long ans = (1LL*cnt1*cnt2)%mod;
    return (int) ans%mod;
    
}
